{
  "$id": "https://noetic.tools/schema/noetic-workflow.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "root": {
      "$ref": "#/$defs/WorkflowNode"
    }
  },
  "required": [
    "version",
    "root"
  ],
  "additionalProperties": false,
  "title": "WorkflowDocument",
  "description": "A portable, JSON-safe representation of a Noetic step tree.",
  "$defs": {
    "WorkflowNode": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "callModel"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string"
            },
            "instructions": {
              "type": "string"
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "parameters": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              }
            },
            "params": {
              "type": "object",
              "properties": {
                "temperature": {
                  "type": "number",
                  "minimum": 0
                },
                "topP": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maxTokens": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "stopSequences": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "output": {
              "type": "object",
              "properties": {
                "codec": {
                  "type": "string",
                  "const": "openui"
                },
                "library": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "codec",
                "library"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "id",
            "instructions"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "invokeTool"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "toolName": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "kind",
            "id",
            "toolName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "runCode"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "execute": {
              "type": "string",
              "minLength": 1
            },
            "retry": {
              "type": "object",
              "properties": {
                "maxAttempts": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "backoff": {
                  "type": "string",
                  "enum": [
                    "fixed",
                    "linear",
                    "exponential"
                  ]
                },
                "initialDelay": {
                  "type": "number",
                  "minimum": 0
                },
                "maxDelay": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "maxAttempts",
                "backoff",
                "initialDelay"
              ],
              "additionalProperties": false
            },
            "subprocess": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "id",
            "execute"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "conditional"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "routes": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "match": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "$ref": "#/$defs/WorkflowNode"
                  }
                },
                "required": [
                  "match",
                  "target"
                ],
                "additionalProperties": false
              }
            },
            "default": {
              "$ref": "#/$defs/WorkflowNode"
            }
          },
          "required": [
            "kind",
            "id",
            "routes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inParallel"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "type": "string",
              "enum": [
                "race",
                "all",
                "settle"
              ]
            },
            "paths": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/WorkflowNode"
              }
            },
            "each": {
              "$ref": "#/$defs/WorkflowNode"
            },
            "over": {
              "type": "string",
              "minLength": 1
            },
            "merge": {
              "type": "string",
              "enum": [
                "last",
                "first",
                "concat"
              ]
            },
            "concurrency": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "id",
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "spawn"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "child": {
              "$ref": "#/$defs/WorkflowNode"
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "layers": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "kind",
            "id",
            "child"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "withContext"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "child": {
              "$ref": "#/$defs/WorkflowNode"
            },
            "layers": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "kind",
            "id",
            "child",
            "layers"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "loop"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "$ref": "#/$defs/WorkflowNode"
            },
            "until": {
              "$ref": "#/$defs/UntilPredicate"
            },
            "maxIterations": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "id",
            "body",
            "until"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sequence"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/WorkflowNode"
              }
            }
          },
          "required": [
            "kind",
            "id",
            "steps"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "schedule"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "step": {
              "$ref": "#/$defs/WorkflowNode"
            },
            "interval": {
              "type": "number",
              "minimum": 0
            },
            "onError": {
              "type": "string",
              "enum": [
                "continue",
                "fail"
              ]
            }
          },
          "required": [
            "kind",
            "id",
            "step",
            "interval"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "subflow"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "document": {
              "$ref": "#"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "input": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "acp-agent"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "agent": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "cwd": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "mcpServers": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "http"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "url": {
                        "type": "string"
                      },
                      "headers": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "value": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "name",
                            "value"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "type",
                      "name",
                      "url",
                      "headers"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "sse"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "url": {
                        "type": "string"
                      },
                      "headers": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "value": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "name",
                            "value"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "type",
                      "name",
                      "url",
                      "headers"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "command": {
                        "type": "string",
                        "minLength": 1
                      },
                      "args": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "env": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "value": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "name",
                            "value"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "name",
                      "command",
                      "args",
                      "env"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "permissions": {
              "type": "object",
              "properties": {
                "default": {
                  "type": "string",
                  "enum": [
                    "allow",
                    "deny",
                    "cancel"
                  ]
                },
                "allow": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "read",
                          "edit",
                          "delete",
                          "move",
                          "search",
                          "execute",
                          "think",
                          "fetch",
                          "switch_mode",
                          "other"
                        ]
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "deny": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "read",
                          "edit",
                          "delete",
                          "move",
                          "search",
                          "execute",
                          "think",
                          "fetch",
                          "switch_mode",
                          "other"
                        ]
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "persist": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "clientCapabilities": {
              "type": "object",
              "properties": {
                "readTextFile": {
                  "type": "boolean"
                },
                "writeTextFile": {
                  "type": "boolean"
                },
                "terminal": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "session": {
              "type": "object",
              "properties": {
                "reuse": {
                  "type": "string",
                  "minLength": 1
                },
                "onComplete": {
                  "type": "string",
                  "enum": [
                    "close",
                    "keep"
                  ]
                },
                "load": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "id",
            "agent",
            "prompt"
          ],
          "additionalProperties": false
        }
      ],
      "title": "WorkflowNode"
    },
    "UntilPredicate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "maxSteps"
            },
            "n": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "n"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "maxCost"
            },
            "usd": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "usd"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "maxDuration"
            },
            "duration": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "duration"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "noToolCalls"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "never"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "outputContains"
            },
            "marker": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "marker"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "outputEquals"
            },
            "sentinel": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "sentinel"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "converged"
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "any"
            },
            "predicates": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/UntilPredicate"
              }
            }
          },
          "required": [
            "kind",
            "predicates"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "all"
            },
            "predicates": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/UntilPredicate"
              }
            }
          },
          "required": [
            "kind",
            "predicates"
          ],
          "additionalProperties": false
        }
      ],
      "title": "UntilPredicate"
    }
  }
}
