{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@noetic-tools/core": ["../core/src/index.ts"],
      "@noetic-tools/core/*": ["../core/src/*"],
      "@noetic-tools/types": ["../types/src/index.ts"],
      "@noetic-tools/types/contract": ["../types/src/types/context-layer.ts"],
      "@noetic-tools/types/*": ["../types/src/*"],
      "@noetic-tools/context": ["../context/src/index.ts"],
      "@noetic-tools/context/*": ["../context/src/*"],
      "@noetic-tools/openui": ["../openui/src/index.ts"],
      "@noetic-tools/openui/server": ["../openui/src/server/index.ts"],
      "@noetic-tools/openui/*": ["../openui/src/*"],
      "@noetic-tools/cli": ["./.typecheck-snippets-shims/noetic-cli.d.ts"],
      "@noetic-tools/platform-node": ["../platform-node/src/index.ts"],
      "@noetic-tools/acp": ["../acp/src/index.ts"],
      "@noetic-tools/eval": ["../eval/src/index.ts"],
      "@noetic/plugin-powerline": ["../plugin-powerline/src/index.tsx"],
      "@noetic/plugin-design-deck": ["../plugin-design-deck/src/index.tsx"]
    }
  }
}
