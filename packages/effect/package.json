{
  "name": "@noetic-tools/effect",
  "version": "0.1.0",
  "type": "module",
  "description": "Effect (effect-ts) adapter for Noetic — run Effect v4 programs as supervised Noetic steps via effectStep(...) or an `effect` JSON workflow node.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattapperson/noetic.git",
    "directory": "packages/effect"
  },
  "homepage": "https://github.com/mattapperson/noetic#readme",
  "bugs": {
    "url": "https://github.com/mattapperson/noetic/issues"
  },
  "keywords": [
    "noetic",
    "agents",
    "effect",
    "effect-ts",
    "steps"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@noetic-tools/context": "workspace:*",
    "@noetic-tools/core": "workspace:*",
    "bun-types": "latest",
    "effect": "4.0.0-rc.112",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@noetic-tools/core": "workspace:*",
    "effect": "^4.0.0-rc.112 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "dependencies": {
    "@noetic-tools/types": "workspace:*"
  },
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "prepublishOnly": "rm -rf dist && bun run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:ci": "bun test --coverage --coverage-reporter=lcov",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --fix .",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format ."
  }
}
