{
  "name": "@noetic-tools/chat-sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "Chat SDK (chat-sdk.dev) integration for Noetic — run a Noetic agent harness as the brain of a multi-platform chat bot via chat.onSubscribedMessage(noeticAgent(...)).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattapperson/noetic.git",
    "directory": "packages/chat-sdk"
  },
  "homepage": "https://github.com/mattapperson/noetic#readme",
  "bugs": {
    "url": "https://github.com/mattapperson/noetic/issues"
  },
  "keywords": [
    "noetic",
    "agents",
    "chat-sdk",
    "chat",
    "slack",
    "discord",
    "teams",
    "telegram",
    "bot"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "ai": "7.0.48",
    "bun-types": "latest",
    "chat": "4.36.0"
  },
  "peerDependencies": {
    "ai": "^6.0.182 || ^7.0.0",
    "chat": "^4.36.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "chat": {
      "optional": true
    }
  },
  "dependencies": {
    "@noetic-tools/types": "workspace:*"
  },
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json && bun scripts/add-js-extensions.ts",
    "verify:esm": "bun scripts/verify-node-esm.ts",
    "prepublishOnly": "rm -rf dist && bun run build && bun run verify:esm && bun scripts/pin-workspace-deps.ts && bun scripts/strip-dev-conditions.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:ci": "bun test --coverage --coverage-reporter=lcov",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --fix .",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format ."
  }
}
