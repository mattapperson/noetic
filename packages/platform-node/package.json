{
  "name": "@noetic-tools/platform-node",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@noetic-tools/core": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "bun-types": "latest"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:ci": "bun test --coverage --coverage-reporter=lcov",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --fix .",
    "build": "bunx tsc -p tsconfig.build.json && bun ../../scripts/add-js-extensions.ts",
    "verify:esm": "bun ../../scripts/verify-node-esm.ts",
    "prepublishOnly": "rm -rf dist && bun run build && bun run verify:esm && bun ../../scripts/prepare-publish.ts ."
  },
  "description": "Local filesystem, process, storage, and IPC adapters for Noetic.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattapperson/noetic.git",
    "directory": "packages/platform-node"
  },
  "homepage": "https://github.com/mattapperson/noetic#readme",
  "bugs": {
    "url": "https://github.com/mattapperson/noetic/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
